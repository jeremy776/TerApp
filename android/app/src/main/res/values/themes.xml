<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TerApp" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@color/app_surface</item>
        <item name="android:navigationBarColor">@color/app_surface</item>
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="colorPrimary">@color/app_accent</item>
        <item name="colorSecondary">@color/app_accent</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_text_primary</item>
        <item name="colorSurfaceVariant">@color/app_surface_variant</item>
        <item name="colorOutline">@color/app_border</item>
        <item name="alertDialogTheme">@style/Theme.TerApp.Dialog</item>
    </style>

    <style name="Theme.TerApp.Dialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="android:background">@color/app_surface</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_text_primary</item>
        <item name="colorPrimary">@color/app_accent</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.TerApp.Dialog</item>
    </style>

    <style name="ShapeAppearance.TerApp.Dialog" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">16dp</item>
    </style>
</resources>
