<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/term_bg_dracula">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/term_surface_dracula"
            app:title="@string/app_name"
            app:titleTextColor="@color/term_fg"
            app:menu="@menu/menu_main" />

        <!-- Multi-Session Tab Strip -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/sessionTabs"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@color/term_surface_dracula"
            app:tabMode="scrollable"
            app:tabSelectedTextColor="@color/term_cyan"
            app:tabTextColor="@color/term_comment"
            app:tabIndicatorColor="@color/term_cyan"
            app:tabIndicatorHeight="2dp" />

        <!-- Terminal View Area (Supports Single Pane or Split-Screen Panes) -->
        <LinearLayout
            android:id="@+id/terminalContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.terapp.TerminalView
                android:id="@+id/terminalView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <View
                android:id="@+id/splitDivider"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/term_cyan"
                android:visibility="gone" />

            <com.terapp.TerminalView
                android:id="@+id/terminalViewSecondary"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Modern Extra Keys Toolbar -->
        <com.terapp.ExtraKeysView
            android:id="@+id/extraKeysView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/term_surface_dracula" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
